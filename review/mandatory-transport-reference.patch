diff --git a/src/chartHttp.ts b/src/chartHttp.ts
new file mode 100644
index 0000000..a6f79fc
--- /dev/null
+++ b/src/chartHttp.ts
@@ -0,0 +1,112 @@
+/** Browser-profiled HTTP transport shared by tile and token requests. */
+import {
+  Impit,
+  TimeoutError,
+  type ImpitResponse,
+  type RequestInit
+} from 'impit'
+import { CookieJar } from 'tough-cookie'
+
+// One browser session: share cookies and keep-alive connections, including
+// between token acquisition and tiles. Cookies stay in memory, scoped by the
+// jar's domain/path/secure rules; they are never written to configuration.
+const browser = new Impit({
+  browser: 'chrome',
+  cookieJar: new CookieJar(),
+  ignoreTlsErrors: false,
+  vanillaFallback: false,
+  followRedirects: false,
+  maxRedirects: 10,
+  timeout: 30000,
+  headers: { 'Accept-Language': 'en-US,en;q=0.9' }
+})
+
+// Narrow response contract also permits Web Response test doubles without
+// pretending impit's native response implements every Web Response property.
+export type ChartResponse = Pick<
+  ImpitResponse,
+  'ok' | 'status' | 'headers' | 'json' | 'arrayBuffer'
+>
+
+export function isChartTimeout(error: unknown): boolean {
+  return (
+    error instanceof TimeoutError ||
+    (error instanceof Error &&
+      (error.name === 'TimeoutError' ||
+        // impit 0.14.8 wraps a timed-out body stream in a plain Error.
+        /^Error reading response stream:.*\bTimedOut\b/.test(error.message)))
+  )
+}
+
+export const chartHttp = {
+  async fetch(url: string, init: RequestInit = {}): Promise<ChartResponse> {
+    const headers = new Headers(init.headers)
+    // Let impit own the browser identity. Old provider configs often contain
+    // just "Mozilla/5.0" or client hints from a different browser/version.
+    // Preserve provider auth, Origin, Referer, content type and other headers.
+    for (const name of [...headers.keys()]) {
+      if (name === 'user-agent' || name.startsWith('sec-ch-ua'))
+        headers.delete(name)
+    }
+    const mode = init.redirect ?? 'follow'
+    // AbortSignal rejects impit's JS promise but does not stop its native I/O.
+    // Bound that I/O too, using one deadline across all redirect hops.
+    const timeout = init.timeout === undefined ? 30000 : init.timeout
+    const deadline = timeout === null ? undefined : Date.now() + timeout
+    let target = new URL(url)
+    let request = { ...init, headers, redirect: 'manual' as const }
+    for (let redirects = 0; ; redirects++) {
+      const remaining = deadline === undefined ? null : deadline - Date.now()
+      if (remaining !== null && remaining <= 0) {
+        throw new DOMException('Chart request timed out', 'TimeoutError')
+      }
+      const response = await browser.fetch(target.toString(), {
+        ...request,
+        timeout: remaining
+      })
+      const location = response.headers.get('location')
+      if (
+        ![301, 302, 303, 307, 308].includes(response.status) ||
+        !location ||
+        mode === 'manual'
+      ) {
+        return response
+      }
+      // impit forwards custom auth headers across origins when following a
+      // redirect itself. Follow explicitly so a provider token cannot leak.
+      await response.arrayBuffer()
+      if (mode === 'error') throw new TypeError('Chart request redirected')
+      if (redirects >= 10) throw new TypeError('Too many chart redirects')
+      const next = new URL(location, target)
+      if (next.protocol !== 'http:' && next.protocol !== 'https:') {
+        throw new TypeError('Unsupported chart redirect protocol')
+      }
+      if (next.origin !== target.origin) {
+        for (const name of [
+          'authorization',
+          'proxy-authorization',
+          'cookie',
+          'host'
+        ])
+          headers.delete(name)
+      }
+      const method = request.method ?? 'GET'
+      if (
+        (response.status === 303 && method !== 'HEAD') ||
+        ((response.status === 301 || response.status === 302) &&
+          method === 'POST')
+      ) {
+        request = { ...request, method: 'GET', body: undefined }
+        for (const name of [
+          'content-type',
+          'content-length',
+          'content-encoding',
+          'content-language',
+          'content-location'
+        ])
+          headers.delete(name)
+      }
+      target = next
+    }
+  }
+}
