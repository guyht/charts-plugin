diff --git a/test/chartHttp-test.ts b/test/chartHttp-test.ts
new file mode 100644
index 0000000..c944708
--- /dev/null
+++ b/test/chartHttp-test.ts
@@ -0,0 +1,385 @@
+import { expect } from 'chai'
+import { chartHttp, isChartTimeout } from '../src/chartHttp'
+import {
+  createServer,
+  type Server,
+  type IncomingMessage,
+  type ServerResponse
+} from 'node:http'
+import { ChartDownloader, FailureKind } from '../src/chartDownloader'
+import { chartProviderFromTokenConfig } from '../src/tokenProvider'
+import type { ChartProvider } from '../src/types'
+
+describe('browser chart transport', function () {
+  this.timeout(5000)
+  let server: Server
+  let origin: string
+  let handle: (req: IncomingMessage, res: ServerResponse) => void
+
+  beforeEach(async () => {
+    ChartDownloader.resetForTests()
+    server = createServer((req, res) => handle(req, res))
+    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve))
+    const address = server.address()
+    if (!address || typeof address === 'string')
+      throw new Error('No server port')
+    origin = `http://127.0.0.1:${address.port}`
+  })
+
+  afterEach(async () => {
+    server.closeAllConnections()
+    await new Promise<void>((resolve, reject) =>
+      server.close((err) => (err ? reject(err) : resolve()))
+    )
+  })
+
+  const provider = (
+    url: string,
+    headers: Record<string, string> = {}
+  ): ChartProvider => ({
+    identifier: 'browser-test',
+    name: 'Browser test',
+    description: '',
+    type: 'tilelayer',
+    scale: 250000,
+    format: 'png',
+    _filePath: '',
+    remoteUrl: url,
+    headers
+  })
+
+  it('sends a coherent Chrome identity instead of generic provider UA/client hints', async () => {
+    handle = (req, res) => res.end(JSON.stringify(req.headers))
+    const result = await ChartDownloader.fetchTileFromRemoteDetailed(
+      provider(origin, {
+        'uSeR-aGeNt': 'Mozilla/5.0',
+        'sEc-Ch-Ua': 'stale-browser',
+        Authorization: 'Bearer provider-secret',
+        Referer: 'https://charts.example/',
+        Origin: 'https://charts.example'
+      }),
+      { z: 1, x: 0, y: 0 }
+    )
+    const headers = JSON.parse(result.buffer!.toString())
+    expect(headers['user-agent']).to.match(/Mozilla\/5\.0 .*Chrome\/\d+/)
+    expect(headers['sec-ch-ua']).not.to.equal('stale-browser')
+    expect(headers['accept-language']).to.equal('en-US,en;q=0.9')
+    expect(headers.authorization).to.equal('Bearer provider-secret')
+    expect(headers.referer).to.equal('https://charts.example/')
+    expect(headers.origin).to.equal('https://charts.example')
+  })
+
+  it('uses the browser transport for both token POST and tile GET, sharing scoped cookies', async () => {
+    const originalFetch = globalThis.fetch
+    globalThis.fetch = async () => {
+      throw new Error('Unexpected native fetch')
+    }
+    const requests: {
+      path: string
+      method: string
+      body: string
+      cookie?: string
+    }[] = []
+    handle = (req, res) => {
+      let body = ''
+      req.on('data', (chunk) => {
+        body += chunk
+      })
+      req.on('end', () => {
+        requests.push({
+          path: req.url!,
+          method: req.method!,
+          body,
+          cookie: req.headers.cookie
+        })
+        if (req.url === '/session/token') {
+          res.setHeader(
+            'set-cookie',
+            'chart-session=accepted; Path=/session; HttpOnly'
+          )
+          res.setHeader('content-type', 'application/json')
+          res.end(JSON.stringify({ access: 'tile-access' }))
+        } else if (
+          req.headers.authorization === 'Bearer tile-access' &&
+          req.headers.cookie?.includes('chart-session=accepted')
+        ) {
+          res.end('bathymetric-tile')
+        } else {
+          res.statusCode = 401
+          res.end('session missing')
+        }
+      })
+    }
+    try {
+      const p = chartProviderFromTokenConfig({
+        identifier: 'browser-token',
+        name: 'Browser token',
+        tokenEndpoint: {
+          url: origin + '/session/token',
+          method: 'POST',
+          body: '{"scope":"charts"}',
+          headers: { 'Content-Type': 'application/json' },
+          ttlSeconds: 60
+        },
+        tile: {
+          url: origin + '/session/tile/{z}/{x}/{y}',
+          headers: { Authorization: 'Bearer {token.access}' }
+        }
+      })
+      const result = await ChartDownloader.fetchTileFromRemoteDetailed(p, {
+        z: 1,
+        x: 0,
+        y: 0
+      })
+      expect(result.buffer?.toString()).to.equal('bathymetric-tile')
+      expect(
+        requests.map(({ path, method, body }) => ({ path, method, body }))
+      ).to.deep.equal([
+        { path: '/session/token', method: 'POST', body: '{"scope":"charts"}' },
+        { path: '/session/tile/1/0/0', method: 'GET', body: '' }
+      ])
+      const outside = await ChartDownloader.fetchTileFromRemoteDetailed(
+        provider(origin + '/outside'),
+        { z: 1, x: 0, y: 0 }
+      )
+      expect(outside.failure.status).to.equal(401)
+      expect(requests[2]!.cookie ?? '').not.to.include('chart-session')
+    } finally {
+      globalThis.fetch = originalFetch
+    }
+  })
+
+  it('follows redirects and retains the response cookie for the redirected request', async () => {
+    handle = (req, res) => {
+      if (req.url === '/redirect/start') {
+        res.writeHead(302, {
+          location: '/redirect/tile',
+          'set-cookie': 'redirect-session=yes; Path=/redirect; HttpOnly'
+        })
+        res.end()
+      } else if (req.headers.cookie?.includes('redirect-session=yes'))
+        res.end('redirected-tile')
+      else {
+        res.statusCode = 401
+        res.end()
+      }
+    }
+    const result = await ChartDownloader.fetchTileFromRemoteDetailed(
+      provider(origin + '/redirect/start'),
+      { z: 1, x: 0, y: 0 }
+    )
+    expect(result.buffer?.toString()).to.equal('redirected-tile')
+  })
+
+  for (const [status, expectedMethod, expectedBody] of [
+    [302, 'GET', ''],
+    [303, 'GET', ''],
+    [307, 'POST', '{"scope":"charts"}'],
+    [308, 'POST', '{"scope":"charts"}']
+  ] as const) {
+    it(`preserves browser POST redirect semantics for ${status}`, async () => {
+      handle = (req, res) => {
+        if (req.url === '/post-start') {
+          res.writeHead(status, { location: '/post-result' })
+          res.end()
+          return
+        }
+        let body = ''
+        req.on('data', (chunk) => {
+          body += chunk
+        })
+        req.on('end', () =>
+          res.end(
+            JSON.stringify({
+              method: req.method,
+              body,
+              type: req.headers['content-type']
+            })
+          )
+        )
+      }
+      const response = await chartHttp.fetch(origin + '/post-start', {
+        method: 'POST',
+        body: '{"scope":"charts"}',
+        headers: { 'Content-Type': 'application/json' }
+      })
+      const result = (await response.json()) as {
+        method: string
+        body: string
+        type?: string
+      }
+      expect(result.method).to.equal(expectedMethod)
+      expect(result.body).to.equal(expectedBody)
+      expect(result.type).to.equal(
+        expectedMethod === 'GET' ? undefined : 'application/json'
+      )
+    })
+  }
+
+  it('limits redirect loops instead of issuing unlimited provider requests', async () => {
+    let attempts = 0
+    handle = (_req, res) => {
+      attempts++
+      res.writeHead(302, { location: '/loop' })
+      res.end()
+    }
+    const result = await ChartDownloader.fetchTileFromRemoteDetailed(
+      provider(origin + '/loop'),
+      { z: 1, x: 0, y: 0 }
+    )
+    expect(result.buffer).to.equal(null)
+    expect(result.failure.kind).to.equal(FailureKind.Network)
+    expect(attempts).to.equal(11)
+  })
+
+  it('still cancels a tile request that stalls before response headers', async () => {
+    handle = () => {}
+    const result = await ChartDownloader.fetchTileFromRemoteDetailed(
+      provider(origin),
+      { z: 1, x: 0, y: 0 },
+      30
+    )
+    expect(result.buffer).to.equal(null)
+    expect(result.failure.kind).to.equal(FailureKind.Timeout)
+  })
+
+  it('uses one native timeout budget across redirect hops', async () => {
+    let attempts = 0
+    handle = (_req, res) => {
+      attempts++
+      setTimeout(() => {
+        res.writeHead(302, { location: '/timed-loop' })
+        res.end()
+      }, 25)
+    }
+    let failure: unknown
+    try {
+      await chartHttp.fetch(origin + '/timed-loop', { timeout: 90 })
+    } catch (error) {
+      failure = error
+    }
+    expect(isChartTimeout(failure)).to.equal(true)
+    expect(attempts).to.be.at.most(4)
+  })
+
+  it('closes the native connection when the tile timeout expires', async () => {
+    let onClose: () => void
+    const closed = new Promise<boolean>((resolve) => {
+      onClose = () => resolve(true)
+    })
+    handle = (req) => req.once('close', onClose)
+    const result = await ChartDownloader.fetchTileFromRemoteDetailed(
+      provider(origin),
+      { z: 1, x: 0, y: 0 },
+      40
+    )
+    expect(result.failure.kind).to.equal(FailureKind.Timeout)
+    const didClose = await Promise.race([
+      closed,
+      new Promise<boolean>((resolve) => setTimeout(() => resolve(false), 300))
+    ])
+    expect(didClose, 'native request still active after cancellation').to.equal(
+      true
+    )
+  })
+
+  it('bounds a stalled tile body after the response headers have arrived', async () => {
+    handle = (_req, res) => {
+      res.writeHead(200)
+      res.write('partial')
+    }
+    const result = await Promise.race([
+      ChartDownloader.fetchTileFromRemoteDetailed(
+        provider(origin),
+        { z: 1, x: 0, y: 0 },
+        40
+      ),
+      new Promise<'still-reading'>((resolve) =>
+        setTimeout(() => resolve('still-reading'), 300)
+      )
+    ])
+    expect(result).not.to.equal('still-reading')
+    if (result === 'still-reading') return
+    expect(result.buffer).to.equal(null)
+    expect(result.failure.kind).to.equal(FailureKind.Timeout)
+  })
+
+  it('preserves the existing 503 retry and binary response bytes', async () => {
+    let attempts = 0
+    handle = (_req, res) => {
+      if (++attempts === 1) {
+        res.statusCode = 503
+        res.end()
+      } else res.end(Buffer.from([0, 128, 255, 1]))
+    }
+    const result = await ChartDownloader.fetchTileFromRemoteDetailed(
+      provider(origin),
+      { z: 1, x: 0, y: 0 }
+    )
+    expect(result.buffer).to.deep.equal(Buffer.from([0, 128, 255, 1]))
+    expect(attempts).to.equal(2)
+  })
+
+  it('does not retry or disguise authentication failures as chart tiles', async () => {
+    let attempts = 0
+    handle = (_req, res) => {
+      attempts++
+      res.statusCode = 403
+      res.end('denied')
+    }
+    const result = await ChartDownloader.fetchTileFromRemoteDetailed(
+      provider(origin),
+      { z: 1, x: 0, y: 0 }
+    )
+    expect(result.buffer).to.equal(null)
+    expect(result.failure.status).to.equal(403)
+    expect(attempts).to.equal(1)
+  })
+})
+
+describe('browser chart redirect credentials', function () {
+  this.timeout(5000)
+  it('does not forward provider authorization to a different origin', async () => {
+    const target = createServer((req, res) =>
+      res.end(JSON.stringify(req.headers))
+    )
+    const source = createServer((_req, res) => {
+      const address = target.address()
+      if (!address || typeof address === 'string')
+        throw new Error('No target port')
+      res.writeHead(302, { location: `http://127.0.0.1:${address.port}/tile` })
+      res.end()
+    })
+    try {
+      await new Promise<void>((r) => target.listen(0, '127.0.0.1', r))
+      await new Promise<void>((r) => source.listen(0, '127.0.0.1', r))
+      const address = source.address()
+      if (!address || typeof address === 'string')
+        throw new Error('No source port')
+      const result = await ChartDownloader.fetchTileFromRemoteDetailed(
+        {
+          identifier: 'redirect-auth',
+          name: 'Redirect auth',
+          description: '',
+          type: 'tilelayer',
+          scale: 250000,
+          format: 'png',
+          _filePath: '',
+          remoteUrl: `http://127.0.0.1:${address.port}/`,
+          headers: { Authorization: 'Bearer private-token' }
+        },
+        { z: 1, x: 0, y: 0 }
+      )
+      const headers = JSON.parse(result.buffer!.toString())
+      expect(headers.authorization).to.equal(undefined)
+    } finally {
+      source.closeAllConnections()
+      target.closeAllConnections()
+      await Promise.all(
+        [source, target].map(
+          (server) => new Promise<void>((r) => server.close(() => r()))
+        )
+      )
+    }
+  })
+})
